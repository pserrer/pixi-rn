{
  "name": "pixi-rn",
  "version": "0.12.0",
  "description": "pixi.js v8 inside React Native on expo-gl: renderer bring-up, retained flex layout, federated native input, texture upload, bitmap text, a frame loop, expo-audio pooling, and a dtMs-driven tween.",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pserrer/pixi-rn.git",
    "directory": "pixi-rn"
  },
  "homepage": "https://github.com/pserrer/pixi-rn#readme",
  "bugs": {
    "url": "https://github.com/pserrer/pixi-rn/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./audio": {
      "import": {
        "types": "./dist/audio.d.mts",
        "default": "./dist/audio.mjs"
      },
      "require": {
        "types": "./dist/audio.d.cts",
        "default": "./dist/audio.cjs"
      }
    },
    "./package.json": "./package.json",
    "./testing/*": "./testing/*"
  },
  "files": [
    "dist",
    "testing",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pixi",
    "pixijs",
    "react-native",
    "expo",
    "expo-gl",
    "webgl",
    "game",
    "ui"
  ],
  "peerDependencies": {
    "expo": "*",
    "expo-asset": "*",
    "expo-audio": "*",
    "expo-gl": "*",
    "pixi.js": "^8.0.0",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo-audio": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.0",
    "typedoc-plugin-frontmatter": "^1.3.1",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.8.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "docs": "typedoc"
  }
}
